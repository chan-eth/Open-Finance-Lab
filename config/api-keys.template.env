# API Keys Template
# Copy this file to .env and add your actual keys
# NEVER commit .env to git!

# ============================================
# Stock/Options Market Data APIs
# ============================================

# Alpha Vantage (Free tier: 25 requests/day)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_key_here

# Polygon.io (Free tier available)
# Get your key at: https://polygon.io/
POLYGON_API_KEY=your_key_here

# Tradier (Free delayed data)
# Get your key at: https://developer.tradier.com/
TRADIER_API_KEY=your_key_here

# ============================================
# Crypto Market Data APIs
# ============================================

# CoinGecko (Free tier: 10-50 calls/min)
# Get your key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_key_here

# CryptoCompare (Free tier available)
# Get your key at: https://min-api.cryptocompare.com/
CRYPTOCOMPARE_API_KEY=your_key_here

# ============================================
# Trading Platform APIs
# ============================================

# Public Brokerage
# Get your keys from: https://public.com/developer
PUBLIC_API_KEY=your_key_here
PUBLIC_API_SECRET=your_secret_here

# Hyperliquid
# Get your keys from Hyperliquid platform
HYPERLIQUID_API_KEY=your_key_here
HYPERLIQUID_API_SECRET=your_secret_here
HYPERLIQUID_VAULT_ADDRESS=your_vault_address_here

# ============================================
# Optional: News & Sentiment APIs
# ============================================

# NewsAPI (Free tier: 100 requests/day)
# Get your key at: https://newsapi.org/
NEWS_API_KEY=your_key_here

# ============================================
# Database & Storage (if needed)
# ============================================

# PostgreSQL connection string (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/financelab

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# ============================================
# Notification Services (optional)
# ============================================

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook (for alerts)
DISCORD_WEBHOOK_URL=your_webhook_url_here

# ============================================
# Settings
# ============================================

# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable paper trading mode
PAPER_TRADING=true

# ============================================
# Notes
# ============================================
#
# Free tier limits (as of 2024):
# - Alpha Vantage: 25 requests/day, 5/minute
# - CoinGecko: 10-50 calls/minute (no registration needed for basic)
# - Polygon: 5 requests/minute free tier
# - NewsAPI: 100 requests/day
#
# Always check current API documentation for latest limits!
